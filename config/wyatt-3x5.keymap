#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        gaming_active: gaming_active {
            compatible = "zmk,behavior-tap-dance";
            label = "GAMING_ACTIVE";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&kp Q>, <&to 0>;
        };

        gaming_deactive: gaming_deactive {
            compatible = "zmk,behavior-tap-dance";
            label = "GAMING_DEACTIVE";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_SHIFT>, <&to 0>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        hl: homerow_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };
    };

    macros {
        vim___0: vim___0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp END &kp ENTER>;
            label = "vim___0";
        };

        vim___w: vim___w {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "VIM___W";
        };
    };

    combos {
        compatible = "zmk,combos";

        BOOT {
            bindings = <&bootloader>;
            key-positions = <0 10 4 14>;
        };

        L1 {
            bindings = <&lt 1 A>;
            key-positions = <10 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        label = "wyatt-3x5";

        default_layer {
            label = "Default";
            bindings = <
&kp ESC    &kp Q  &kp W  &tog 1  &kp BACKSPACE
&kp LSHFT  &kp A  &kp S  &kp D   &kp F
&kp LCTRL  &kp Z  &kp X  &kp C   &kp SPACE
            >;
        };

        layer_1 {
            bindings = <
&kp M      &kp I  &trans  &tog 2  &trans
&kp P      &kp Q  &kp W   &trans  &kp T
&kp ENTER  &kp A  &kp S   &kp D   &trans
            >;
        };

        layer_2 {
            bindings = <
&kp UP_ARROW    &mmv MOVE_UP    &trans  &kp LEFT_ARROW  &kp RIGHT
&kp DOWN_ARROW  &mmv MOVE_DOWN  &trans  &kp F           &kp GRAVE
&kp ESC         &trans          &trans  &kp E           &kp SPACE
            >;
        };
    };
};
